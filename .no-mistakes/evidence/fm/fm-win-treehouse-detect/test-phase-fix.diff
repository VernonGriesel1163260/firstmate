diff --git a/bin/fm-spawn-path-lib.sh b/bin/fm-spawn-path-lib.sh
index af224736..f577698f 100644
--- a/bin/fm-spawn-path-lib.sh
+++ b/bin/fm-spawn-path-lib.sh
@@ -42,6 +42,16 @@ fm_spawn_shell_worktree_path() { # <target>
     # read requires a complete line: never publish a partially written path.
     if [ -f "$reply_file" ] && IFS= read -r path < "$reply_file" && [ -n "$path" ]; then
       path=${path%$'\r'}
+      # PowerShell's `>` redirect (Windows PowerShell 5.1, herdr's default
+      # endpoint shell on Windows) writes UTF-16 with a byte-order mark; bash's
+      # read drops the interior NUL bytes, so the mark survives as a prefix and
+      # would make cygpath emit an empty path. Strip any recognized BOM before
+      # conversion; shells without one (cmd.exe, POSIX) are unaffected.
+      case "$path" in
+        $'\357\273\277'*) path=${path:3} ;;
+        $'\376\377'*) path=${path:2} ;;
+        $'\377\376'*) path=${path:2} ;;
+      esac
       rm -rf -- "$reply_dir"
       [ -n "$path" ] || return 1
       case "$OSTYPE" in
diff --git a/tests/fm-spawn-worktree-settle.test.sh b/tests/fm-spawn-worktree-settle.test.sh
index f0673aae..9229d6b1 100755
--- a/tests/fm-spawn-worktree-settle.test.sh
+++ b/tests/fm-spawn-worktree-settle.test.sh
@@ -83,6 +83,19 @@ case "${1:-}" in
           [ "${FM_FAKE_SHELL_SILENT:-0}" != 1 ] || exit 0
           path=$(pane_path)
           (cd "$path" && eval "$arg")
+          # Windows PowerShell 5.1 (herdr's default endpoint shell) redirects
+          # `>` as UTF-16 with a byte-order mark; model that reply shape.
+          case "${FM_FAKE_REPLY_UTF16:-0}" in
+            1)
+              reply=${arg#git rev-parse --show-toplevel > }
+              reply=${reply#\"}; reply=${reply%\"}
+              [ -s "$reply" ] || exit 0
+              utf16_tmp="$reply.u16"
+              printf '\377\376' > "$utf16_tmp" \
+                && iconv -f UTF-8 -t UTF-16LE "$reply" >> "$utf16_tmp" \
+                && mv -f "$utf16_tmp" "$reply" || rm -f "$utf16_tmp"
+              ;;
+          esac
           exit $? ;;
       esac
     done
